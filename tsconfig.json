{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"lib": [
			"dom",
			"es6",
			"es2017",
			"esnext.asynciterable"
		],
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "./dist",
		"moduleResolution": "node",
		"removeComments": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"baseUrl": "./",
		"paths": {
			"@adapters/*": [
				"src/application/adapters/*"
			],
			"@entities/*": [
				"src/application/entities/*"
			],
			"@repositories/*": [
				"src/application/repositories/*"
			],
			"@use-cases/*": [
				"src/application/use-cases/*"
			],
			"@utils/*": [
				"src/core/utils/*"
			],
			"@clients/*": [
				"src/core/clients/*"
			],
			"@constants/*": [
				"src/core/constants/*"
			],
			"@http/*": [
				"src/servers/http/*"
			],
			"@messaging/*": [
				"src/servers/messaging/*"
			],
			"@db/*": [
				"src/db/*"
			],
		}
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"./src/**/*.ts",
		"env.ts"
	]
}